# ── Python ─────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.ruff_cache/

# ── Environment ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example


# ── Logs ────────────────────────────────────────────────────────────────────
logs/

# ── Hugo build output ────────────────────────────────────────────────────────
site/public/
site/resources/
site/.hugo_build.lock
site/content/dev/
site/content/conferences/
site/content/datasets/
site/content/papers/
site/content/dev_profile_tmp/
site/static/data/datasets/
site/static/figures/
site/data/*.json
.deploy*
deploy-archives/
.github-pages/

# ── Papers: keep local workspace data out of git ────────────────────────────
papers/*
papers/.*
!papers/.gitkeep

# ── Experiment sources are tracked; generated outputs stay local ─────────────
experiments/**/*.csv
experiments/**/*.json
experiments/**/*.log
experiments/**/*.md
experiments/**/*.pdf
experiments/**/*.png
experiments/**/*.svg
experiments/**/*.tex
experiments/**/*.txt
experiments/**/*.yaml
experiments/**/*.yml
experiments/**/logs/

# ── Dataset statistics workspace (derived from paper extraction) ─────────────
datasets/*
datasets/.*
!datasets/.gitkeep

# ── SQLite WAL sidecars (main DB is versioned) ───────────────────────────────
data/benchmarks.db-wal
data/benchmarks.db-shm
data/benchmarks.db-*
data/benchmarks-current.db-*
data2/

# ── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.kilo
.vscode/settings.json
.cache
cache/
hub/
.pre-commit-cache
.agent_harnesses.json
/.Trash-*/
papers.txt
config/ogb_papers.txt
