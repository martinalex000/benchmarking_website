# Copy this file to .env and fill in your values.
# Never commit .env to git.

# OpenAI-compatible LLM endpoint (no trailing slash)
# Local vLLM + Qwen example:
#   vllm serve Qwen/Qwen3-32B --host 127.0.0.1 --port 8000 --api-key local-dev
LLM_ENDPOINT=http://127.0.0.1:8000/v1

# API key for the endpoint. Must match --api-key if set on vLLM.
LLM_API_KEY=local-dev

# Optional second backend for compare_models: local vLLM while LLM_ENDPOINT is external.
# When a model ID exists on both servers, the local copy is preferred.
# LLM_LOCAL_ENDPOINT=http://127.0.0.1:8000/v1
# LLM_LOCAL_API_KEY=local-dev

# Model IDs must exactly match what your endpoint returns from GET /v1/models.
# For a single-model local vLLM server, you can point all tiers at the same model.
LLM_MODEL_PRIMARY=Qwen/Qwen3-32B
LLM_MODEL_FALLBACK=Qwen/Qwen3-32B
LLM_MODEL_SMALL=Qwen/Qwen3-32B

# Optional override for compare_models baseline (default: LLM_MODEL_FALLBACK, then glm-4.7)
# LLM_COMPARE_BASELINE=moonshotai/Kimi-K2.6

# Hosted endpoint example:
# LLM_ENDPOINT=https://your-llm-endpoint.example.com/v1
# LLM_API_KEY=your-api-key-here
# LLM_MODEL_PRIMARY=openai-gpt-oss120b
# LLM_MODEL_FALLBACK=minimax
# LLM_MODEL_SMALL=gemma-3-27b

# Semantic Scholar API key (https://www.semanticscholar.org/product/api)
# Without a key requests are rate-limited to ~100/5min; with a key the limit is much higher.
# SEMANTIC_SCHOLAR_API_KEY=your-api-key-here

# Deployment target for deploy.sh
# DEPLOY_USER=martin
# DEPLOY_HOST=your-server.example.com
# DEPLOY_PATH=/var/www/benchmarks

# Optional remote build host (SSH config alias or hostname). When set, deploy.py
# builds archives on that machine, copies them here, then uploads to DEPLOY_HOST.
# BUILD_HOST=alpha
# BUILD_USER=
# BUILD_PROJECT_ROOT=/path/to/benchmarking_website
